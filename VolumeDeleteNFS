#!/bin/sh
cd /TopStor
echo $@ > ~/`basename "$0"`
datenow=`date +%m/%d/%Y`; timenow=`date +%T`;
volname=`echo $@ | awk '{print $3}'`;
leaderip=`echo $@ | awk '{print $1}'`;
pDG=`echo $@ | awk '{print $2}'`;
pro=`echo $@ | awk '{print $4}'`;
userreq=` echo $@ | awk '{print $5}'`;
DG=$pDG; name=$volname;   # the dataset of the volume (it was the text "pDG/" - the address and type lookups below found nothing, the share container kept the dataset busy)
privilege=$pro;
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]]
then
	myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
	myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
	leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
	echo $leader | grep $myhost
	if [ $? -ne 0 ];
	then
		echo hihih
 		etcd=$myhostip
	else
		echo nono
 		etcd=$leaderip
 	fi
 echo etcd=$etcd
 docker exec etcdclient /TopStor/logmsg.py NFS1000 info $userreq $pDG/$volname
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq
 if ! /sbin/zfs list -H -o name $DG/$name >/dev/null 2>&1; then
  # no dataset (the leftover etcd key of a failed create, test 635): remove its keys, and the address/container when the key
  # names one (nfsremove.sh), instead of failing on zfs destroy with the key left behind
  kval=`/pace/etcdget.py $etcd volumes --prefix | grep "/$DG/$name'" | head -1 | awk -F"', '" '{print $2}' | tr -d "')]"`
  ipaddr=`echo "$kval" | awk -F'/' '{print $10}'`
  ipsubnet=`echo "$kval" | awk -F'/' '{print $11}'`
  if [ -n "$ipaddr" ] && [ -n "$ipsubnet" ]; then
   /TopStor/nfsremove.sh $leaderip $pDG $volname $ipaddr $ipsubnet NFS 2>/root/errcifsremove
  else
   for pfx in vol replivol size tenant; do /TopStor/etcddel.py $leaderip $pfx $volname; done
  fi
  stamp=`date +%s`
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${pDG}_$name/request volumes_$stamp
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${pDG}_$name/request/$leader volumes_$stamp
  docker exec etcdclient /TopStor/logmsg.py NFS1002 info $userreq $pDG/$volname
  docker exec etcdclient /TopStor/etcdputlocal.py dirty/volume 0
  docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
  exit
 fi
 ipaddr=`zfs get -H ip:addr $DG/$name | awk '{print $3}'`
 ipsubnet=`zfs get -H ip:subnet $DG/$name | awk '{print $3}'`
 vtype=`zfs get -H prot:kind $DG/$name | awk '{print $3}'`
 echo ip=$ipaddr
 stamp=`date +%s`
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${pDG}_$name/request volumes_$stamp
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${pDG}_$name/request/$leader volumes_$stamp
 /TopStor/nfsremove.sh $leaderip $pDG $volname $ipaddr $ipsubnet $vtype 2>/root/errcifsremove
 /TopStor/SnapShotPeriodDelete $leaderip $volname $userreq
 echo /sbin/zfs destroy -rf $pDG/$volname 
 /sbin/zfs unmount -f $pDG/$volname 
 /sbin/zfs destroy -rf $pDG/$volname 
 if [ $? -ne 0  ]; then
   docker exec etcdclient /TopStor/logmsg.py NFS1001 error $userreq $volname
   echo /sbin/zfs destroy -rf $pDG/$volname >/root/errorVolumeDeleteCIFS
   docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
   exit
 fi
 rm -rf $pDG/$volname 
 echo rm -rf $pDG/$volname 
 docker exec etcdclient /TopStor/logmsg.py NFS1002 info $userreq $pDG/$volname
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
fi
 docker exec etcdclient /TopStor/etcdputlocal.py dirty/volume 0
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
