#!/bin/bash
echo $@ > /root/unixchangeuser
export ETCDCTL_API=3
cd /TopStor
leaderip=`echo $@ | awk '{print $1}'`;
username=`echo $@ | awk '{print $2}'`;
usergroups=`echo $@ | awk  '{print $3}' | sed 's/groups//g' `;
userreq=`echo $@  | awk '{print $4}'`;
# every user is always a member of Everyone (the front end does not show or send that group)
if [[ $username != 'NoUser' ]] && getent group Everyone >/dev/null;
then
	if [[ $usergroups == 'NoGroup' || -z $usergroups ]];
	then
		usergroups='Everyone'
	else
		echo ",$usergroups," | grep -q ',Everyone,' || usergroups=$usergroups',Everyone'
	fi
fi
ischange=`echo $@  | awk '{print $5}'`;
pullsync=`echo $@  | awk '{print $6}'`;
stablegrp=""
# Group member lists (field 3 of usersigroup/<group>: "a,b,c" or NoUser) are read and edited by EXACT comma separated names:
# a name never matches a part of another name (q015a / q015a1 / q015a10 / xq015a / group q015ag, test 614).
# mlist_has <list> <name>: true when <name> is one element of <list>
mlist_has() { echo ",$1," | grep -qF ",$2,"; }
# mlist_del <list> <name>: <list> without <name> (empty elements and NoUser/no dropped; NoUser when nothing is left)
mlist_del() { echo "$1" | awk -F, -v n="$2" '{o=""; for(i=1;i<=NF;i++) if($i!="" && $i!="NoUser" && $i!="no" && $i!=n) o=o (o==""?"":",") $i; print (o==""?"NoUser":o)}'; }
# mlist_add <list> <name>: <list> with <name> appended once (empty elements and NoUser/no dropped)
mlist_add() { echo "$1" | awk -F, -v n="$2" '{o=""; f=0; for(i=1;i<=NF;i++) if($i!="" && $i!="NoUser" && $i!="no"){ if($i==n) f=1; o=o (o==""?"":",") $i }; if(!f) o=o (o==""?"":",") n; print o}'; }
# groupsof <etcd> <name>: the groups (usersigroup/<group>) whose member list holds <name> exactly. etcdget.py with a filter
# argument matches any text of the whole key/value pair, so "usersigroup q015a" also returned q015ag and every group of q015a1.
groupsof() { /pace/etcdget.py $1 usersigroup --prefix | sed -n "s/^('usersigroup\/\([^']*\)', '\(.*\)')\$/\1 \2/p" | while read -r g v; do mlist_has "`echo "$v" | cut -d/ -f3`" "$2" && echo "$g"; done; }
# Notifications (logmsg.py/logqueue.py) cost 1.2-2.4 s each (python, pika, a new RabbitMQ connection) and nothing here reads
# their result, so they run in the background, while this script runs in the single command consumer (topstorrecvreply.py).
# Each one waits (at most 10 s) for the one sent before it, so they still arrive in the order they are sent; a nested
# UnixChangeUser joins the same chain through TS_NOTIFYPIDFILE. No output may reach the consumer's pipe (it waits for EOF).
notifyfile=${TS_NOTIFYPIDFILE:-/tmp/topstornotify.$$}
notify() {
	local prev=''
	[ -s "$notifyfile" ] && read -r prev < "$notifyfile"
	( n=0; while [ -n "$prev" ] && [ $n -lt 100 ] && kill -0 "$prev" 2>/dev/null; do sleep 0.1; n=$((n+1)); done
	  docker exec etcdclient "$@" ) </dev/null >/dev/null 2>&1 &
	echo $! > "$notifyfile"
}
[ -z "$TS_NOTIFYPIDFILE" ] && trap 'rm -f "$notifyfile"' EXIT
privilege="Box_Users";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]];
then
	notify /TopStor/logqueue.py `basename "$0"` running $userreq 
	# UnixAddUser hands its values over (TS_*); otherwise clusternode, clusternodeip and leader in ONE docker exec (was three)
	myhost=$TS_MYHOST; myhostip=$TS_MYHOSTIP; leader=$TS_LEADER
	if [ -z "$myhost" -o -z "$myhostip" -o -z "$leader" ]
	then
		hostinfo=`docker exec -w /TopStor etcdclient /usr/bin/python3 -c 'from etcdgetlocal import etcdget; [etcdget(k) for k in ("clusternode","clusternodeip","leader")]'`
		{ read -r myhost; read -r myhostip; read -r leader; } <<< "$hostinfo"
	fi
	if [ -z "$myhost" -o -z "$myhostip" -o -z "$leader" ]
	then
		myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
		myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
		leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
	fi
	echo $leader | grep $myhost
	if [ $? -eq 0 ];
	then
	 	etcd=$leaderip
	else
		etcd=$myhostip
	fi
 #if a change happens before a user is created, no need to proceed, the script will be run again in the AddUser
 id $username
 if [ $? -ne 0 ];
 then
	notify /TopStor/logqueue.py `basename "$0"` finish $userreq 
	exit 
 fi
 if [ "$username" != 'NoUser' ];
 then
 	echo s$pullsync | grep pull 
 	if [ $? -ne 0 ];
 	then
  		notify /TopStor/logmsg.py Unst1024 info $userreq $username
	fi
 fi
 if [ "$username" != 'NoUser' ];
 then
  if [[ $usergroups == 'NoGroup' ]];
  then
   usermod -G '' $username
  else
   usermod -G '' $username
   usermod -G $usergroups $username
  fi
  usermod -a -G $username  $username
  for cgrp in `groupsof $etcd $username`;
  do
   if ! mlist_has "$usergroups" "$cgrp";
   then
    usersall=`/pace/etcdget.py $etcd usersigroup/$cgrp`
    cusers=`echo $usersall | awk -F'/' '{print $3}'`
    cusersleft=`echo $usersall | cut -d/ -f1-2`
    cusersright=`echo $usersall | cut -d/ -f4-`
    newusers=`mlist_del "$cusers" "$username"`
    newop=$cusersleft'/'$newusers'/'$cusersright
    groupres=$newop
    echo to remove : $cgrp to be $groupres
 echo $etcd '333333333333333333333333333333333333333333333333333333333333333'
    /pace/etcdput.py $etcd usersigroup/$cgrp $groupres 
   else
    stablegrp=${stablegrp}${cgrp}',';
    echo to keep : $cgrp
   fi
  done
  echo the stable=$stablegrp
  usergroups=$usergroups','
  grpsl=` echo ${usergroups} | sed 's/,/ /g' | wc -w`
  while [ $grpsl -gt 0 ]; 
  do
   l=`echo $usergroups |  cut -d, -f 1`
   usergroups=`echo $usergroups | sed 's/ /,/g' | cut -d, -f2-`
   usergroups=$usergroups','
   grpsl=` echo ${usergroups} | sed 's/,/ /g' | wc -w`
   if [ -z "$l" ] || [ "$l" = "$username" ];
   then
	continue
   fi
   echo usrgroups=$usergroups
   echo grpsl=$grpsl
   echo stablegrp=$stablegrp
   if [ "$l" != 'NoGroup' ];
   then
    if ! mlist_has "$stablegrp" "$l";
    then
     usersall=`/pace/etcdget.py $etcd usersigroup/$l`
     cusers=`echo $usersall | awk -F'/' '{print $3}'`
     cusersleft=`echo $usersall | cut -d/ -f1-2`
     cusersright=`echo $usersall | cut -d/ -f4-`
     newusers=`mlist_add "$cusers" "$username"`
     newop=$cusersleft'/'$newusers'/'$cusersright
     groupres=$newop
     echo adding $l to be $groupres
     /pace/etcdput.py $etcd usersigroup/$l $groupres 
    fi
   fi
  done
######### or else username=NoUser.. Remove all users form this usergroups
 else
  allusers=`/pace/etcdget.py $etcd usersigroup/$usergroups`
  usersall=`echo $allusers | awk -F'/' '{print $3}'`','
  usersl=` echo ${usersall} | sed 's/,/ /g' | wc -w`
  while [ $usersl -gt 0 ]; 
  do
   l=`echo $usersall |  cut -d, -f 1`
   usersall=`echo $usersall | sed 's/ /,/g' | cut -d, -f2-`
   usersall=$usersall','
   usersl=`echo ${usersall} | sed 's/,/ /g' | wc -w`
   echo l=$l
   echo usersall=$usersall
   echo usersl=$usersl
   gpasswd -d $l $usergroups
  done
   cusers=`echo $allusers | awk -F'/' '{print $3}'`
   cusersleft=`echo $allusers | cut -d/ -f1-2`
   cusersright=`echo $allusers | cut -d/ -f4-`
   newusers='NoUser'
   newop=$cusersleft'/'$newusers'/'$cusersright
   groupres=`echo ${newop}`
   /pace/etcdput.py $etcd usersigroup/$usergroups  $groupres 
 fi
 #/TopStor/broadcast.py UserChange /TopStor/pump.sh UnixChangeUser_sync -d$myhost $@ 
 if [ "$username" != 'NoUser' ];
 then
	echo s$pullsync | grep pull 
 	if [ $? -ne 0 ];
 	then
  		notify /TopStor/logmsg.py Unsu1024 info $userreq $username
	fi
 fi
 echo dddddddddddddddddddddddddd $leader, $myhost
 echo $leader | grep $myhost
 if [ $? -eq 0 ];
 then
	stamp=`date +%s`;
	stamp=$((stamp+10))
	myscript=`basename "$0"`
	params=`echo $myscript $@ pull | sed 's\ \\_\g'`
	echo params=$params
	echo /pace/etcdput.py $etcd sync/UsrChange/$params/request/$myhost UsrChange_$stamp
	/TopStor/etcdput.py $etcd sync/UsrChange/$params/request/$myhost UsrChange_$stamp
	/TopStor/etcdput.py $etcd sync/UsrChange/$params/request UsrChange_$stamp
 fi
 notify /TopStor/logqueue.py `basename "$0"` finish $userreq 
fi
