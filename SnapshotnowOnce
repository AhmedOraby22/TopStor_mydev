#!/bin/sh
echo $@ > /root/snapnowparam
cd /TopStor
leaderip=`echo $@ | awk '{print $1}'`;
name=`echo $@ | awk '{print $2}'` ;
pool=`echo $@ | awk '{print $3}'`;
vol=`echo $@ | awk '{print $4}'`;
receiver=`echo $@ | awk '{print $5}'` ;
userreq=`echo $@ | awk '{print $6}'` ;
stamp=`date +%s`;
snapshot=$pool'/'$vol'@'${name}'.'$stamp
echo new snpashot-$snapshot
# QSD5.345 (test 660): the epoch suffix never clashes in zfs, so refuse a name this volume already has (<name>.<epoch>)
zfs list -H -t snapshot -o name -d 1 $pool'/'$vol 2>/dev/null | awk -F'@' '{print $2}' | sed 's/\.[0-9]*$//' | grep -qFx -- "$name"
if [ $? -eq 0 ];
then
 echo snapshot name $name already exists on $pool/$vol
 docker exec etcdclient /TopStor/logmsg.py Snap1047 error $userreq $name $vol
 exit 1
fi
shortreceiver=`echo $receiver | awk -F'_' '{print $1}'`
	myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
	myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
	leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
	echo $leader | grep $myhost
	if [ $? -ne 0 ];
	then
 		etcd=$myhostip
	else
 		etcd=$leaderip
 	fi

docker exec etcdclient /TopStor/logqueue.py `basename "$0"` start system 
echo $receiver | grep NoReceiver
if [ $? -ne 0 ];
then 
 docker exec etcdclient /TopStor/logmsg.py Replispacest01 info $userreq $vol $shortreceiver  
 echo /TopStor/logmsg.py Replispacest01 info $userreq $vol $shortreceiver  
else
 docker exec etcdclient /TopStor/logmsg.py Snap1026 info $userreq $name 
fi
zfs snapshot $snapshot 
if [ $? -ne 0  ]; then
      echo failed
      docker exec etcdclient /TopStor/logmsg.py Snap1028 error $userreq $name 
      exit 1;
else
 docker exec etcdclient /TopStor/logmsg.py Snap1030 info $userreq $name 
fi 
result='init'
zfs set snap:type=Once $snapshot 
echo $receiver | grep NoReceive
if [ $? -eq 0 ];
then
	waiting=0
else
 	waiting=1
fi
# test 22: running/<receiver> is written on the leader, so it is read there too (a non-leader's local copy can be a stale
# "running" left from an earlier send). A send that is still running is waited for (at most 300 s); a key that stays set
# longer is stale: it is reset and this send goes on. It used to exit here silently: no stream, no success or failure message.
waited=0
while [ $waiting -eq 1 ];
do
  running=`/TopStor/etcdget.py $leaderip running/$receiver`
  echo $running | grep -w -- $receiver
  if [ $? -eq 0 ];
  then
   echo waiting the current replications to finish
   waited=$((waited+1))
   if [ $waited -ge 300 ];
   then
    echo running/$receiver stayed set for 300 s: stale, reset
    /TopStor/etcdput.py $leaderip running/$receiver no
    waiting=0
   fi
   sleep 1
  else
   waiting=0
  fi
done
echo $receiver | grep NoReceive
if [ $? -ne 0 ];
then
 zfs set partner:receiver=$receiver $snapshot 
 /TopStor/etcdput.py $leaderip running/$receiver $receiver
 /TopStor/etcdput.py $leaderip sync/running/____/request running_$stamp
 /TopStor/etcdput.py $leaderip sync/running/____/request/$leader running_$stamp
 echo ./replicatenow.py $leaderip $etcd $snapshot $receiver
 raw=`./replicatenow.py $leaderip $etcd $snapshot $receiver 2>&1`
 result=`echo $raw | grep 'result_' | awk -F'result_' '{print $2}'`
 echo .................................................................
 echo result=$result
 echo ............................................
 # success only when replicatenow.py says so: an empty result (it crashed before sending, test 22 step 16) is a failure
 echo $raw | grep -q 'replicatenow_success'
 if [ $? -ne 0 ];
 then
  #./logmsg.py Replispacefa01 error $userreq $shortreceiver $vol
  docker exec etcdclient /TopStor/logmsg.py Streamfa01 error $userreq $vol $shortreceiver
 else
  docker exec etcdclient /TopStor/logmsg.py Replispacesu01 info $userreq $vol $shortreceiver
 fi 
 /TopStor/etcdput.py $leaderip running/$receiver finish 
 # a new stamp: with the start stamp a node that synced the "running" request never took the "finish" one
 fstamp=`date +%s%N`
 /TopStor/etcdput.py $leaderip sync/running/____/request running_$fstamp
 /TopStor/etcdput.py $leaderip sync/running/____/request/$leader running_$fstamp
fi 
docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop system 
#sleep 2;
